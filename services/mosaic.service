[Unit]
Description=mosaic - auto-discovering host for skill-produced apps
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/tools/mosaic
ExecStart=%h/workspace/tools/mosaic/.venv/bin/uvicorn backend.app:app --host 127.0.0.1 --port 47500
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target personal-services.target
